# KernelSU-Next + SUSFS (non-GKI, manual hook)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y

# Match the running PixelOS 17 kernel vermagic exactly, so /vendor .ko modules load.
# The workflow overwrites localversion-cip/-st with -cip136 / -st20. The shipped
# kernel gets -perf-g<sha> from CONFIG_LOCALVERSION_AUTO, which cannot be
# reproduced from a tarball without .git, so pin the same string and turn AUTO off.
CONFIG_LOCALVERSION="-perf-gf914d0b24613"
# CONFIG_LOCALVERSION_AUTO is not set

# Everything else (LTO_CLANG, CFI_CLANG, SHADOW_CALL_STACK, FRAME_WARN=4096, ...)
# is left exactly as vendor/kona-perf_defconfig + vendor/xiaomi/*.config set it,
# so the result matches the kernel that ships in the ROM.
