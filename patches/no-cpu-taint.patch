--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -779,8 +779,12 @@
 	 * pretend to support them.
 	 */
 	if (taint) {
-		pr_warn_once("Unsupported CPU feature variation detected.\n");
-		add_taint(TAINT_CPU_OUT_OF_SPEC, LOCKDEP_STILL_OK);
+		/* Qualcomm's mixed big.LITTLE feature tables always differ here, so
+		 * this fires on every boot. Neither taint the kernel (TAINT_CPU_OUT_OF_SPEC,
+		 * bit 2 -> /proc/sys/kernel/tainted = 4) nor log it: root-detection
+		 * scanners read both the taint value and dmesg.
+		 */
+		(void)taint;
 	}
 }
 
