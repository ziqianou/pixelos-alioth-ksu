 void __init __weak init_random_pool(void) { }
 
+
+/*
+ * The bootloader reports verifiedbootstate=orange because it is unlocked.
+ * Init turns the androidboot.* parameters into ro.boot.* properties, so
+ * rewrite them in place (same length) in both the kernel command line and the
+ * DT /chosen/bootargs property. Init then sets ro.boot.* itself: no resetprop,
+ * no property-serial anomaly, and /proc/cmdline, /proc/device-tree and getprop
+ * all agree.
+ */
+static void __init spoof_androidboot_cmdline(char *cmdline)
+{
+	static const struct { const char *from, *to; } map[] = {
+		{ "androidboot.verifiedbootstate=orange",
+		  "androidboot.verifiedbootstate=green " },
+		{ "androidboot.vbmeta.device_state=unlocked",
+		  "androidboot.vbmeta.device_state=locked  " },
+		{ "androidboot.flash.locked=0",
+		  "androidboot.flash.locked=1" },
+	};
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(map); i++) {
+		size_t n = strlen(map[i].from);
+		char *p = cmdline;
+
+		while ((p = strstr(p, map[i].from))) {
+			memcpy(p, map[i].to, n);
+			p += n;
+		}
+	}
+}
+
+static void __init spoof_androidboot(void)
+{
+	struct device_node *chosen;
+	const char *args;
+	int len;
+
+	spoof_androidboot_cmdline(boot_command_line);
+
+	chosen = of_find_node_by_path("/chosen");
+	if (!chosen)
+		return;
+	args = of_get_property(chosen, "bootargs", &len);
+	if (args && len > 0)
+		spoof_androidboot_cmdline((char *)args);
+	of_node_put(chosen);
+}
+
 void __init setup_arch(char **cmdline_p)
 {
 	init_mm.start_code = (unsigned long) _text;
@@ -344,6 +394,8 @@
 	if (acpi_disabled)
 		unflatten_device_tree();
 
+	spoof_androidboot();
+
