Android 17's native zygote (system/zygote) uses the full capability list,
including CAP_CHECKPOINT_RESTORE (40).  The 4.19 base only knows caps up
to CAP_BPF (39), so PR_CAPBSET_READ/PR_CAPBSET_DROP(40) returns EINVAL and
the zygote child panics (SIGABRT) while dropping its bounding set.

Bump CAP_LAST_CAP to CAP_CHECKPOINT_RESTORE and add the matching SELinux
capability permission.  The permission order must match plat_sepolicy.cil
(perfmon, checkpoint_restore, bpf), not numeric capability order.

--- a/include/uapi/linux/capability.h
+++ b/include/uapi/linux/capability.h
@@ -404,8 +404,9 @@
  * CAP_NET_ADMIN and CAP_BPF are required to load networking programs.
  */
 #define CAP_BPF			39
-
-#define CAP_LAST_CAP         CAP_BPF
+#define CAP_CHECKPOINT_RESTORE	40
+
+#define CAP_LAST_CAP         CAP_CHECKPOINT_RESTORE
 
 #define cap_valid(x) ((x) >= 0 && (x) <= CAP_LAST_CAP)
 
--- a/security/selinux/include/classmap.h
+++ b/security/selinux/include/classmap.h
@@ -26,9 +26,9 @@
 	    "audit_control", "setfcap"
 
 #define COMMON_CAP2_PERMS  "mac_override", "mac_admin", "syslog", \
-		"wake_alarm", "block_suspend", "audit_read", "perfmon", "bpf"
-
-#if CAP_LAST_CAP > CAP_BPF
+		"wake_alarm", "block_suspend", "audit_read", "perfmon", "checkpoint_restore", "bpf"
+
+#if CAP_LAST_CAP > CAP_CHECKPOINT_RESTORE
 #error New capability defined, please update COMMON_CAP2_PERMS.
 #endif
 
